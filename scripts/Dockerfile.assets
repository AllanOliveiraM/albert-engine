FROM debian:12-slim
RUN apt-get update && apt-get install -y --no-install-recommends \
    ca-certificates curl python3 python3-gdal python3-pil python3-numpy python3-pip gdal-bin \
    && rm -rf /var/lib/apt/lists/*
RUN pip3 install --break-system-packages --no-cache-dir --no-deps spiceypy==8.3.0
WORKDIR /work
ENTRYPOINT ["python3", "scripts/prepare-assets.py"]
