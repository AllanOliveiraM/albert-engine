file(READ "${PROJECT_SOURCE_DIR}/assets/manifest.json" asset_manifest)
string(JSON asset_count LENGTH "${asset_manifest}" files)
math(EXPR last_asset "${asset_count} - 1")
foreach(index RANGE 0 ${last_asset})
    string(JSON asset GET "${asset_manifest}" files ${index} path)
    string(JSON expected GET "${asset_manifest}" files ${index} sha256)
    if(NOT EXISTS "${PROJECT_SOURCE_DIR}/assets/${asset}")
        message(FATAL_ERROR "Missing bundled asset: assets/${asset}. Restore the file from the repository.")
    endif()
    file(SHA256 "${PROJECT_SOURCE_DIR}/assets/${asset}" actual)
    if(NOT actual STREQUAL expected)
        message(FATAL_ERROR "Checksum mismatch for assets/${asset}. Restore the file or update its manifest for an intentional asset change.")
    endif()
endforeach()
